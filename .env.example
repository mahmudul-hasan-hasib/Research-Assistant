# Insight environment template.
# Copy to `.env` and fill in locally. Secrets are never committed.
# See docs/ARCHITECTURE.md Part 11 (Security).

# --- Application ---
APP_NAME=insight
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://insight:insight@localhost:5432/insight

# --- Authentication (Part 11: short-lived JWT + rotating hashed refresh tokens) ---
# JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Object storage (S3 / MinIO) ---
# STORAGE_BACKEND=local          # "local" (dev/tests) or "s3" (S3/MinIO)
# STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=insight
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# --- Uploads (Part 11) ---
# UPLOAD_MAX_SIZE_BYTES=104857600

# --- LLM providers (switchable via configuration) ---
# Only "gemini" is implemented in this phase; the factory fails closed on unknown keys.
ACTIVE_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- RAG (Part 6 — ingestion + retrieval) ---
# Splitting: "langchain" (RecursiveCharacterTextSplitter) | "llamaindex" (SentenceSplitter)
# RAG_SPLITTER=langchain
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=160
# Embeddings: "sentence_transformers" (local model) | "memory" (deterministic hashes, dev/tests)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# Vector store: "faiss" (local index dir) | "memory" (in-process, dev/tests)
VECTOR_STORE_BACKEND=faiss
VECTOR_INDEX_DIR=./vector_index
# Retrieval
# RAG_TOP_K=8
# RAG_ENABLE_QUERY_REWRITE=false

# --- Agent orchestrator (Part 7 — planning) ---
# AGENT_MAX_STEPS=5
# AGENT_PLANNER_INSTRUCTION=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
